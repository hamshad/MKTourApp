# TikTok Events SDK
# Fill these manually from TikTok Events Manager.
# Android + iOS App IDs, TikTok IDs, and Access Token (App Secret).
TIKTOK_ANDROID_APP_ID=
TIKTOK_ANDROID_TIKTOK_ID=
TIKTOK_IOS_APP_ID=
TIKTOK_IOS_TIKTOK_ID=
TIKTOK_ACCESS_TOKEN=

